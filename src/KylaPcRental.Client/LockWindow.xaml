<Window x:Class="KylaPcRental.Client.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#0B0B0B"
        Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="40">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="650">
            <TextBlock Text="🔒 TIME EXPIRED" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Your gaming session has ended." FontSize="24" HorizontalAlignment="Center" Margin="0,18,0,30"/>
            <TextBlock Text="Would you like to extend?" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,24"/>
            <UniformGrid Columns="3">
                <Button Content="1 HOUR&#x0a;₱40" FontSize="22" Height="120" Margin="8" Click="OneHour_Click"/>
                <Button Content="2 HOURS&#x0a;₱80" FontSize="22" Height="120" Margin="8" Click="TwoHours_Click"/>
                <Button Content="3 HOURS&#x0a;₱120" FontSize="22" Height="120" Margin="8" Click="ThreeHours_Click"/>
            </UniformGrid>
            <TextBlock Text="Minimum extension: 1 hour • Please see the attendant to pay." FontSize="16" Opacity="0.65" HorizontalAlignment="Center" Margin="0,22,0,0"/>
        </StackPanel>
    </Grid>
</Window>
